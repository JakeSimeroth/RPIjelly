# RPIjelly configuration — copy this file to ".env" and fill it in.
#   cp .env.example .env && nano .env
#
# .env is git-ignored so your secrets never get committed.

# --- Identity / locale -------------------------------------------------------
# Run `id` on the Pi to get your user's UID/GID (usually 1000/1000).
PUID=1000
PGID=1000
# Your timezone — see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/Denver

# LAN IP of the Pi (used by Jellyfin for client auto-discovery). Optional.
# Find it with `hostname -I`. Leave blank to fall back to localhost.
HOST_LAN_IP=

# --- Storage layout (point these at the NVMe SSD) ----------------------------
# App config / databases. Lives on fast, durable NVMe — NOT the microSD.
DATA_ROOT=/mnt/nvme/rpijelly
# Your media library. movies/ and tv/ subfolders are created automatically.
MEDIA_ROOT=/mnt/nvme/media
# Where qBittorrent saves downloads (Sonarr imports from here).
DOWNLOADS_ROOT=/mnt/nvme/downloads

# --- Pi-hole -----------------------------------------------------------------
# Admin/API password for http://<pi>:8081/admin  (set something strong).
PIHOLE_PASSWORD=changeme
# Upstream DNS resolvers, semicolon-separated. Default: Cloudflare.
# Examples: Quad9 = 9.9.9.9;149.112.112.112  |  Google = 8.8.8.8;8.8.4.4
PIHOLE_DNS=1.1.1.1;1.0.0.1

# --- Tailscale ---------------------------------------------------------------
# Generate a reusable auth key at https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTHKEY=tskey-auth-xxxxxxxxxxxx
# Name this machine shows up as in your tailnet.
TS_HOSTNAME=rpijelly
# Optional: advertise your LAN subnet so remote devices can reach other home
# devices through the Pi (e.g. 192.168.1.0/24). Leave blank to skip.
# Requires approving the route in the Tailscale admin console.
TS_ADVERTISE_ROUTES=
